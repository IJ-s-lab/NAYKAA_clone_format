    width: 26px;
    height: 24px;
    display: inline-block;
    background: url(/assets/desktop/images/chat_logo.svg) no-repeat 0 0;
    margin-top: 11px;
    margin-left: 15px;
    position: relative;
}
  
.verloop-livechat-logo.verloop-livechat-logo::after {
    display: inline-block;
    content: "How may we help you";
    top: 2px;
}

.verloop-livechat-logo.verloop-livechat-logo::before, .verloop-livechat-logo.verloop-livechat-logo::after {
    display: inline-block;
    position: absolute;
    left: 36px;
    width: 160px;
    font-size: 16px;
}
