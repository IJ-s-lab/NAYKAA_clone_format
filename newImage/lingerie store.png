.left-message {
    position: absolute;
    left: 0;
    top: 0;
    animation: slide 5s infinite;
}
.leftDiv div:nth-child(2) {
    animation-delay: 5s;
    opacity: 0;
}
@keyframes slide {
    0% {
        transform: translateY(40px);
        opacity: 1;
    }
    5%,
    50% {
        transform: translateY(0);
        opacity: 1;
    }
    51% {
        transform: translateY(-40px);
        opacity: 0;
    }
    51.1%,
    100% {
        transform: translateY(40px);
        opacity: 0;
    }
