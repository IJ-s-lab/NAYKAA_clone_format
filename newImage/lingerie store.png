var LoadDeniedHtml = `<style type="text/css">*{margin:0;padding:0;}@font-face{font-family:'SourceSansProSemibold';src:url('https://www.nykaa.com/skin/frontend/nykaa/theme202/css/font/SourceSansPro/SourceSansPro-Semibold.eot');src:url('https://www.nykaa.com/skin/frontend/nykaa/theme202/css/font/SourceSansPro/SourceSansPro-Semibold.eot?#iefix') format('embedded-opentype'),url('https://www.nykaa.com/skin/frontend/nykaa/theme202/css/font/SourceSansPro/SourceSansPro-Semibold.ttf')format('truetype'),url('https://www.nykaa.com/skin/frontend/nykaa/theme202/css/font/SourceSansPro/SourceSansPro-Semibold.svg#SourceSansPro-Semibold') format('svg');font-weight: normal;font-style: normal;}.BoxContainer{position: relative; overflow: hidden; width:40%;}a.CloseBtn {position: absolute;    top: 4px;right: 3px;display: block;z-index: 2;color:#fff;font-family: 'SourceSansPro-Semibold';font-size: 15px;text-decoration: none; }.gmg_arrow-up {width: 0; height: 0;border-left: 10px solid transparent;border-right: 10px solid transparent;border-bottom: 10px solid #fc2779;position: relative;left: 6%;top: 1px;}.posRelative{position: relative;}a.posRelative{display: block; text-decoration: none;}	.Notification{width: 90%;background-color: #fc2779;top: 0;display: table-cell;padding: 2%;	}.Notification a{color: #fff; font-family: 'SourceSansPro-Semibold';font-size: 13px; font-weight: 600; letter-spacing: 0.3px;}</style><div class="BoxContainer" style="position: fixed;top: 0;z-index: 9999;"><div class="gmg_arrow-up"></div><a href="" class="CloseBtn">x</a><div class="Notification"><a class="posRelative" href="">If you change your mind, click the lock to give <span>Chrome</span> permission to send you desktop notifications.</a></div></div>`;

//Original web permissions

//Every started session we are checking in previos session we show custom notif
_taq.handlers.push(["event","started session",
  function(ev) {
    var checkMayBeLater = _taq.getLSItem("mayBeLater");
    var checkLoadDenied = _taq.getLSItem("isDenied");
    if (checkMayBeLater == "true") {
      _taq.removeLSItem("mayBeLater");
    }
    if (checkLoadDenied == "true") {
      _taq.removeLSItem("isDenied");
    }

    return ev;
  }
]);


//Main Code start
//Every window load we are checking some conditons to show our two soft push notificationn
_taq.handlers.push(["ready",function() {
  if(location.search.indexOf('ptype=product') == -1 && location.href.indexOf('/p/') == -1){
    var x = JSON.parse(_taq.getLSItem('sess_data'));
    if(typeof(Notification) != 'undefined' &&  x["IP"] != "183.82.114.14" ){
      var checkMayBeLater = _taq.getLSItem("mayBeLater");
      var ChromePermission = Notification.permission == "denied" ? true : false;
      var checkLoadDenied = _taq.getLSItem("isDenied");
      var ssdata = JSON.parse(_taq.getLSItem("sess_data"));
      var baseOs = ssdata["base browser"];
      if (checkMayBeLater != "true" && baseOs != "iOS") {
        //RenderSoftWebpush(true);
      }
      if (ChromePermission && baseOs != "iOS" && checkLoadDenied != "true") {
        if(location.href.includes("test_gmg_webpush")){
          DeniedNotifShow();
        }
      }
    }
  }
}]);

//Main Code Ends
//This function will show the content when browser permissons are blocked
function DeniedNotifShow() {
  _taq.is_incognito(function(is_incognito) {
    if (is_incognito == false && _taq.is_mobile == false) {
      _taq.$("body").append(LoadDeniedHtml);
      _taq.setLSItem("isDenied", "true");
      $(".CloseBtn").click(function() {
        pushEvent('wp_bcustom_close', {});
        $(".BoxContainer").hide();
      });
    }
  });
}

//This function will show custom soft webpush with some custom contions
function RenderSoftWebpush(timeToShow) {
  var loadHTML = _taq.is_mobile ? mobileHTML : webHTML;
  var ChromePermission = Notification.permission == "denied" ? false : true;
  var gamoogaPermission =
    _taq.getLSItem("webpush_status") == "registered" ? false : true;
  var isDenied = _taq.getLSItem("webpush_status") == "denied" ? false : true;
  //This condition is for when gmg per is denied but chrome per are alowed we are passing true
  var cros_per = ChromePermission === true || isDenied === false ||(ChromePermission && gamoogaPermission)? true : false;
  var permission =timeToShow && ChromePermission && gamoogaPermission && cros_per;
  _taq.is_incognito(function(is_incognito) {
    if (is_incognito == false && permission) {
      _taq.$("body").append(loadHTML);
      //pushEvent is by default contains url and device so we are passing empty object
      pushEvent("wp_show_custom", {});
    }
  });
}

function show_wp_request() {
    _taq.do_webpush_registration();
    _taq.$('#gmg_wp_notif').hide();
    pushEvent('wp_allowed_custom', {});
}

function hide_wp_request() {
    _taq.setLSItem('mayBeLater', "true");
    _taq.$('#gmg_wp_notif').hide();
    pushEvent('wp_later_custom', {});
}

function pushEvent(event, data) {
    data['url'] = location.href;
    data['device'] = (_taq.is_mobile ? 'Mobile' : 'Web');
    _taq.events.push([event, data]);
}

//testing 18th May & 20th May
