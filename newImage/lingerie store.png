    --black: #ffffff;
    --white: #ffffff;
}
/***** inter font import *****/
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');
html {
    -webkit-font-smoothing: antialiased;
}
body {
    text-rendering: optimizeLegibility;
    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;
}
img {
    max-width: 100%;
    width: auto\9;
    height: auto;
    vertical-align: middle;
    border: 0;
    -ms-interpolation-mode: bicubic;
}
#headerWpr {
    font-family: 'Inter', sans-serif !important;
    font-weight: 400;
}
#headerWpr .MegaDropdownHeadingbox {
    font-family: inherit;
}
#headerWpr #HeaderMenu .AccountText {
    font-family: inherit;
}
#headerWpr #HeaderMenu .menuContainer_main ul.HeaderNav > li > a {
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    /* letter-spacing: 0.1px; */
    text-transform: capitalize;
}
/*home page header css override start*/
#header_id {
    font-family: 'Inter', sans-serif !important;
    font-weight: 400;
}
#header_id .MegaDropdownHeadingbox {
    font-family: inherit;
}
#header_id #HeaderMenu .menuContainer_main ul.HeaderNav > li > a {
    font-size: 14px;
    font-weight: 600;
    /* letter-spacing: 0.1px; */
    text-transform: capitalize;
}
/*home page header css override end*/
/***** Header Top Strip CSS start *****/
#offer-banner {
    height: 40px;
    line-height: 40px;
    padding: 0px;
    position: relative;
    z-index: 10001 !important;
}
#offer-banner.top-strip-bg {
    height: 40px !important;
    background-size: cover !important;
    background-color: #fc2779;
    background-image: url(https://images-static.naikaa.com/media/wysiwyg/2021/common-strip.jpg);
    /*background-image: url(https://images-static.naikaa.com/media/wysiwyg/2024/top-strip-dec.jpg);*/
    background-repeat: no-repeat;
    background-position: center center;
}
.top_strip_wrapper {
    width: 1140px;
    height: 40px;
    margin: 0 auto;
}
.leftDiv > .left-message:not(:first-child) {
    display: none;
}
.leftDiv a {
    color: var(--black);
    text-decoration: none;
}
.leftDiv a:hover {
    color: #000;
    text-decoration: none;
}
.rightDiv ul {
    height: 40px;
}
.rightDiv ul li {
    display: inline-block;
    width: auto;
    height: 40px;
    line-height: 40px;
    padding: 0 13px;
}
.rightDiv ul li a {
    width: 100%;
    display: inline-block;
    text-decoration: none;
    color: var(--black) !important;
    cursor: pointer;
}
.rightDiv ul li a svg g {
    fill: var(--black) !important;
}
.rightDiv ul li a span {
    font-size: 14px;
    float: left;
}
.rightDiv ul li a span:hover,
.rightDiv ul li a:hover {
    text-decoration: none !important;
    color: #000 !important;
}
.rightDiv ul li a::after {
    content: "";
    width: 1px;
    height: 20px;
    background: var(--black);
    position: absolute;
    top: 10px;
    margin-left: 13px;
}
.rightDiv ul li:last-child {
    padding-right: 0;
}
.rightDiv ul li:last-child a::after {
    content: none;
}
.top-strip-icons {
    background-image: url(https://adn-static2.nykaa.com/media/wysiwyg/HeaderIcons/menusprite1.png);
    background-repeat: no-repeat;
    height: 40px;
    width: 18px;
    float: left;
    margin: 0 5px 0 0;
}
.left-message,
.right-message {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.1px;
    line-height: 40px;
    border: 0px !important;
}
.top_strip_wrapper .ts-icon svg {
    width: 24px;
    margin-top: 8px;
    vertical-align: top;
}
.top_strip_wrapper .ts-text {
    margin-left: 2px;
}
.rightDiv ul li a span:hover .ts-icon svg g,
.rightDiv ul li a:hover .ts-icon svg g {
    fill: #000 !important;
}
/***** Header Top Strip CSS end *****/
/***** Header Mega Menu CSS start *****/
.MegaDropdown-ContentInner .MegaDropdown-ContentHeading.allpro_marginbtm {
