_taq.handlers.push(['event','cart_add',function(ev){
  var body='';
  var $=_taq.$;
  var cart_subtotal=0;
  if(window.sonar_basket.products){
  for(i=0;i<window.sonar_basket.products.length;i++){
    cart_subtotal=cart_subtotal+Math.round(parseFloat(window.sonar_basket.products[i]['amount'])/(1-0.1111));
    }
  var shipping_chrg=0;
  var cart_total=cart_subtotal;
  if(cart_subtotal<500){
    shipping_chrg=50;
    cart_total=cart_subtotal+shipping_chrg;
  }
  else{
    shipping_chrg='Free';
  }
  $('#sliding-cart-form > table > tbody > tr').each(function(i,e){
    var imgurl=$(e).find('td > a > img').attr('src');
    var prodname=$(e).find('.product_detail > a > span').text().trim();
    var produrl=$(e).find('.product_detail > a').attr('href');
    var prodqty=parseInt($(e).find('.product_detail > .product_qty_blck > input').val());
    var price = $(e).find('.last_col > span > .price_block').text().trim();
    if(price!="Free"){
    	price=parseFloat(price.replace("Rs. ","").replace(/[^0-9.]/g,"")).toFixed(2);  
    }    
    body=body+'<tr>'+
      '<td align="center">'+
          '<a href="'+produrl+'?utm_source=gamooga&utm_medium=email&utm_campaign=cartabandonment" style="display:block;"><img  style="padding:10px;" src="'+imgurl+'" width="80" height="80" alt="" ></a>'+
      '</td>'+
      '<td style="padding:10px;">'+
          '<a href="'+produrl+'?utm_source=gamooga&utm_medium=email&utm_campaign=cartabandonment" style="text-decoration:none;font-size:16px; font-weight:700; color:#fc5294;">'+prodname+'</a>'+
      '</td>'+
      '<td align="center" style="padding:0.8em;"><b>'+prodqty+'</b></td>'+
      '<td style="padding:0.8em;" ><b> Rs. '+price+' </b></td>'+
  	'</tr>';
  });
  var prod_price_str=parseFloat(ev[1]['prod_price']).toFixed(2);
  ev[1]['prod_price']=parseFloat(prod_price_str);
  ev[1]['cartitems']=body;
  ev[1]['cart_subtotal']=cart_subtotal;
  ev[1]['cart_total']=cart_total;
  ev[1]['shipping_chrg']=shipping_chrg;
  var img_url=ev[1]['prod_img'];
  if(ev[1]['prod_name']=='null' || ev[1]['prod_name'] === null){
    return false;
  }
  else{
   	return ev; 
  }
  }
}]);

